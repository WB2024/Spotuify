# Copy this file to .env and fill in the values from your Spotify Developer
# Dashboard app (https://developer.spotify.com/dashboard).
#
# In the app's settings, add this exact Redirect URI (must match SPOTIFY_REDIRECT_PORT
# below): http://127.0.0.1:8080/callback

Spotify_ClientID=your_client_id_here
SpotifySecret=your_client_secret_here

# Optional overrides (all editable from the app's Settings screen too):
# SPOTIFY_REDIRECT_PORT=8080
# SPOTUIFY_EXPORT_DIR=./exports
# SPOTUIFY_DOWNLOAD_COVERS=true

# Local-library matching (maps Spotify playlists to local files and writes
# .m3u8 playlists). Spotuify reads your Navidrome server's database rather
# than re-scanning files itself, since Navidrome has already tagged
# everything. NAVIDROME_DB is the navidrome.db path on this machine;
# NAVIDROME_MUSIC_PATH is this machine's path to the same folder Navidrome
# mounts as its music root (its ND_MUSICFOLDER) — Navidrome stores each
# track's path relative to that root, the same remote-path-mapping idea
# *arr apps use.
# SPOTUIFY_NAVIDROME_DB=/path/to/navidrome/data/navidrome.db
# SPOTUIFY_NAVIDROME_MUSIC_PATH=/path/to/your/music
# SPOTUIFY_M3U8_DIR=./playlists
# SPOTUIFY_RESOLVE_MUSICBRAINZ_ISRC=true
# SPOTUIFY_FUZZY_MATCH=true

# Optional: upload each playlist's cover art into Navidrome itself (it
# doesn't auto-adopt a cover.jpg file sitting in the playlist's folder the
# way it auto-imports the .m3u8 — this needs an authenticated call to its
# own REST API). Leave unset to skip; the .m3u8 and local cover.jpg are
# written either way.
# SPOTUIFY_NAVIDROME_API_URL=http://your-navidrome-server
# SPOTUIFY_NAVIDROME_API_USERNAME=your_navidrome_username
# SPOTUIFY_NAVIDROME_API_PASSWORD=your_navidrome_password

# Optional: let the match results screen add a missing track's album to
# Lidarr (l / L). Root folder and profiles are easiest to pick from the
# Settings screen, which fetches the choices from Lidarr — the IDs below
# are Lidarr's own. ADD_AND_SEARCH is the default mode (true: queue a
# search immediately; false: just monitor and let Lidarr's RSS sync find
# it), overridable per add with "s".
# SPOTUIFY_LIDARR_URL=http://your-lidarr-server:8686
# SPOTUIFY_LIDARR_API_KEY=your_lidarr_api_key
# SPOTUIFY_LIDARR_ROOT_FOLDER=/music
# SPOTUIFY_LIDARR_QUALITY_PROFILE_ID=1
# SPOTUIFY_LIDARR_METADATA_PROFILE_ID=1
# SPOTUIFY_LIDARR_ADD_AND_SEARCH=false
